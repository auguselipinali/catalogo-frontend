# URL base de la API del catálogo (sin slash final).
# Copiar este archivo a .env y ajustar según el entorno.
VITE_API_URL=http://localhost:5238

# Número de WhatsApp del comercio para recibir los pedidos del catálogo.
# Formato internacional, solo dígitos: código de país + área + número,
# sin +, espacios ni guiones. Ej. Argentina: 5493511234567
VITE_WHATSAPP_NUMERO=5490000000000
